---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFPagesLazy from "@/components/SectionPDFPages/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="N-Up PDF files online for free. | PDFvise"
  description="N-Up PDF files online without uploading, with no watermarks, & completely free! N-Up PDF files easily on your browser only!."
>
  <SectionRibbon title="N-Up PDF" description="N-Up multiple PDF files." />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFPagesLazy tool="n-up" client:load />
    </div>
    <SectionHowTo
      title="How to N-Up multiple PDF files together?"
      description="N-Up PDF files online without uploading, with no watermarks, & completely free! N-Up PDF files easily on your browser only!."
    >
      <ol>
        <li>Select all PDF files</li>
        <li>Re-order, Rotate, or Remove your files</li>
        <li>Save & Download</li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  items={[
    { question: "How many PDF files I can N-Up at once with PDFvise?", answer: "PDFvise can place several files on shared sheets. There is no count limit. A single PDF can be up to 100 MB." },
    { question: "Can I N-Up PDF and rotate pages?", answer: "After selecting multiple files, you can rotate all pages of the PDF on PDFvise." },
    { question: "Can I N-Up PDF and add margin?", answer: "After selecting multiple files on PDFvise, you can add margins to all pages of the PDF." },
    { question: "Where are PDF files saved after merging?", answer: "Respecting your privacy, PDFvise uploads no files to any secondary location. All files are only available at your browser and your system." },
  ]}
/>
  </div>
</BaseLayout>
