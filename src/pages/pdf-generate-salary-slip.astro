---
import SectionGenerateLazy from "@/components/SectionGenerate/lazy";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Create a salary slip PDF online for free. | PDFvise"
  description="Create a salary slip PDF online without uploading, with no watermarks, and completely free. The PDF is built in your browser."
>
  <SectionRibbon
    title="Salary Slip"
    description="Add earnings and deductions, then download a PDF."
  />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionGenerateLazy kind="salary" client:load />
    </div>
    <SectionHowTo
      title="How to create a salary slip?"
      description="Create a salary slip PDF in your browser. Nothing is uploaded."
    >
      <ol>
        <li>Enter the employer, employee, period, and amounts</li>
        <li>Save & Download</li>
      </ol>
    </SectionHowTo>
  </div>
</BaseLayout>
