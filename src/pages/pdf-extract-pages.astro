---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFPagesLazy from "@/components/SectionPDFPages/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Extract PDF Pages online for free. | PDFvise"
  description="Extract PDF Page online without uploading, with no watermarks, & completely free! Extract PDF Pages easily on your browser only!."
>
  <SectionRibbon
    title="Extract PDF Pages"
    description="Extract individual pages of a PDF file"
  />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFPagesLazy tool="extract" client:load />
    </div>
    <SectionHowTo
      title="How to Extract Pages of a PDF file?"
      description="Extract PDF Page online without uploading, with no watermarks, & completely free! Extract PDF Pages easily on your browser only!."
    >
      <ol>
        <li>Select all PDF files</li>
        <li>Re-order, Rotate, or Remove pages you want to skip</li>
        <li>
          Save & Download. Batch size starts at 1, so each page you keep is its
          own PDF.
        </li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  items={[
    { question: "Can I Rotate a PDF while extracting pages of a PDF file?", answer: "After selecting a PDF file on PDFvise, you can choose to rotate the file by 90°, 180°, or 270°." },
  ]}
/>
  </div>
</BaseLayout>
