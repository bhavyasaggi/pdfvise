---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFExtractImagesLazy from "@/components/SectionPDFExtractImages/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Extract Images from PDF files online for free. | PDFvise"
  description="Extract all Images from a PDF file online without uploading, with no watermarks, & completely free! Extract Images from PDF files easily on your browser only!"
>
  <SectionRibbon
    title="Extract PDF Images"
    description="Extract all Images from a PDF file."
  />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFExtractImagesLazy client:load />
    </div>
    <SectionHowTo
      title="How to Extract all Images from a PDF file?"
      description="Extract all Images from a PDF file online without uploading, with no watermarks, & completely free! Extract Images from PDF files easily on your browser only!."
    >
      <ol>
        <li>Select all PDF files</li>
        <li>Re-order, or Remove your images</li>
        <li>Save & Download ZIP</li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  items={[
    { question: "Can I extract images from multiple PDF files at once?", answer: "Yes. Add more than one PDF, and PDFvise extracts the embedded images from all of them into a single ZIP file. A PDF with no embedded images is reported instead of an empty download." },
  ]}
/>
  </div>
</BaseLayout>
