---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFPagesLazy from "@/components/SectionPDFPages/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Rotate PDF Pages online for free. | PDFvise"
  description="Rotate PDF Page online without uploading, with no watermarks, & completely free! Rotate PDF Pages easily on your browser only!."
>
  <SectionRibbon
    title="Rotate PDF Pages"
    description="Rotate individual pages of a PDF file"
  />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFPagesLazy tool="rotate-pages" client:load />
    </div>
    <SectionHowTo
      title="How to rotate Pages of a PDF file?"
      description="Rotate PDF Page online without uploading, with no watermarks, & completely free! Rotate PDF Pages easily on your browser only!."
    >
      <ol>
        <li>Select all PDF files</li>
        <li>Re-order, Rotate, or Remove your files</li>
        <li>Save & Download</li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  items={[
    { question: "Can I rotate a single page?", answer: "Use the rotate button on a page card. Each click turns that page by 90 degrees. Save & Download writes the rotation into the PDF." },
  ]}
/>
  </div>
</BaseLayout>
