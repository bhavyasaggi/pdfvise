---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFPagesLazy from "@/components/SectionPDFPages/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Merge PDF files online for free. | PDFvise"
  description="Merge PDF files online without uploading, with no watermarks, & completely free! Merge PDF files easily on your browser only!."
>
  <SectionRibbon title="Merge PDF" description="Merge multiple PDF files." />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFPagesLazy tool="merge" client:load />
    </div>
    <SectionHowTo
      title="How to merge multiple PDF files together?"
      description="Merge PDF files online without uploading, with no watermarks, & completely free! Merge PDF files easily on your browser only!."
    >
      <ol>
        <li>Select all PDF files</li>
        <li>Re-order, Rotate, or Remove your files</li>
        <li>Save & Download</li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  items={[
    { question: "How many PDF files I can merge at once with PDFvise?", answer: "PDFvise can merge several files into one PDF. There is no count limit. A single PDF can be up to 100 MB." },
    { question: "Can I merge PDF and rotate pages?", answer: "After selecting multiple files, you can rotate all pages of the PDF on PDFvise." },
    { question: "Can I merge PDF and add margin?", answer: "After selecting multiple files on PDFvise, you can add margins to all pages of the PDF." },
    { question: "Where are PDF files saved after merging?", answer: "Respecting your privacy, PDFvise uploads no files to any secondary location. All files are only available at your browser and your system." },
  ]}
/>
  </div>
</BaseLayout>
