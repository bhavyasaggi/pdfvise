---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFPagesLazy from "@/components/SectionPDFPages/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Add Margin to PDF files online for free. | PDFvise"
  description="Add Margin to PDF files online without uploading, with no watermarks, & completely free! Add Margin to PDF files easily on your browser only!."
>
  <SectionRibbon
    title="Add Margin to PDF"
    description="Add Margin to PDF files online securely, without uploading, no watermarks, no registration, no daily-limit, in bulk, & completely free!"
  />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFPagesLazy tool="margin" client:load />
    </div>
    <SectionHowTo
      title="How to add Margin to a PDF File?"
      description="Pdfvise allows hassle-free addition of margin to PDF without downloading or installing any software."
    >
      <ol>
        <li>
          <strong>Select PDF files</strong>
          <ul>
            <li>
              Be assured that the files are safe and never uploaded anywhere.
            </li>
            <li>
              Everything happens locally in the browser with highest level of
              security possible.
            </li>
          </ul>
        </li>
        <li>
          <strong>Add Additional files</strong>
          <ul>
            <li>
              You may also add additional files to add margin to multiple files
              at same time.
            </li>
            <li>Several files can be added at once. Nothing is uploaded.</li>
          </ul>
        </li>
        <li>
          <strong>Add margins</strong>
          <ul>
            <li>
              Set measurement for each margin on the PDF file in inches,
              centimeters, or millimeters.
            </li>
            <li>
              The utility allows for different margin for each side, while
              preserving the ratio of the page.
            </li>
            <li>
              Rest assured that the document will be readable, printable, and
              will have no stretching because of the modifications.
            </li>
          </ul>
        </li>
        <li>
          <strong>Re-order, Rotate, or Remove your files.</strong>
          <ul>
            <li>A single PDF can be up to 100 MB. There is no daily cap.</li>
            <li>
              The add margin to PDF can be used with no worries about usage or
              security concerns.
            </li>
          </ul>
        </li>
        <li>
          <strong>Save &amp; Download</strong>
          <ul>
            <li>
              After adjusting the PDF or adding margins, the document will be
              processed and will be available for Download.
            </li>
          </ul>
        </li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  intro="Add margin to your PDF file and begin working on it right away. PDFvise permits simplicity, flexibility, and security while you add margin to PDF file online with your computer or mobile device."
  items={[
    { question: "What is Add Margin to PDF ?", answer: "Add margin to PDF is a free and secure online utility to insert margin to PDF pages. Easily add margin to every PDF page and improve page layout by eliminating bleeding while reading or printing PDF." },
    { question: "Can I Rotate a PDF file while adding margin to a PDF file ?", answer: "After selecting a PDF file on PDFvise, you can choose to rotate the file by 90°, 180°, or 270°." },
    { question: "Which units can I use for the margin?", answer: "Each margin field accepts inches, centimeters, or millimeters. A value of 0 leaves that edge unchanged." },
  ]}
/>
  </div>
</BaseLayout>
