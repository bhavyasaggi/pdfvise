---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFPagesLazy from "@/components/SectionPDFPages/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Add page numbers to a PDF online for free. | PDFvise"
  description="Add page numbers to a PDF online without uploading, with no watermarks, and completely free. Number PDF pages in your browser."
>
  <SectionRibbon
    title="Add Page Numbers"
    description="Stamp a footer on every page."
  />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFPagesLazy tool="page-number" client:load />
    </div>
    <SectionHowTo
      title="How to number PDF pages?"
      description="Add page numbers online without uploading. The footer is drawn in your browser."
    >
      <ol>
        <li>Select PDF files</li>
        <li>Edit the footer. {"{n}"} is the page number and {"{total}"} is the page count</li>
        <li>Save & Download</li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  items={[
    { question: "Do the numbers follow the order I arrange?", answer: "Yes. Reorder, rotate, or remove pages first. The footer counts the pages in the file you download." },
  ]}
/>
  </div>
</BaseLayout>
