---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFMetaLazy from "@/components/SectionPDFMeta/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Reorder PDF Pages online for free. | PDFvise"
  description="Reorder PDF Pages online without uploading, with no watermarks, & completely free!. Sort PDF files easily on your browser only!."
>
  <SectionRibbon
    title="Reorder PDF"
    description="Sort and Organize pages of a PDF file in any order"
  />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFMetaLazy tool="reorder" client:load />
    </div>
    <SectionHowTo
      title="How to sort and organize pages of a PDF file in any order?"
      description="Reorder PDF Pages online without uploading, with no watermarks, & completely free!. Sort PDF files easily on your browser only!"
    >
      <ol>
        <li>Select all PDF files</li>
        <li>Re-order, Rotate, or Remove your files</li>
        <li>Save & Download</li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  items={[
    { question: "Can I Rotate a PDF while reordering pages of a PDF file?", answer: "After selecting a PDF file on PDFvise, you can choose to rotate the file by 90°, 180°, or 270°." },
  ]}
/>
  </div>
</BaseLayout>
