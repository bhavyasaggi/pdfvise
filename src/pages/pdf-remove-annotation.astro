---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFPagesLazy from "@/components/SectionPDFPages/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Remove PDF Annotation online for free. | PDFvise"
  description="Remove PDF annotations online without uploading, with no watermarks, and completely free. Drop comments and links in your browser."
>
  <SectionRibbon
    title="Remove PDF Annotation"
    description="Remove Annotation of PDF files."
  />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFPagesLazy tool="remove-annotation" client:load />
    </div>
    <SectionHowTo
      title="How to Remove Annotation of PDF files?"
      description="Drop comments, links, and other annotations in your browser. The page content stays."
    >
      <ol>
        <li>Select all PDF files</li>
        <li>Re-order, Rotate, or Remove your files</li>
        <li>Save & Download</li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  items={[
    { question: "Can I Rotate a PDF while removing annotation of a PDF file?", answer: "After selecting a PDF file on PDFvise, you can choose to rotate the file by 90°, 180°, or 270°." },
  ]}
/>
  </div>
</BaseLayout>
