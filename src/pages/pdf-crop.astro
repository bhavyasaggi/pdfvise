---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFPagesLazy from "@/components/SectionPDFPages/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Crop PDF files online for free. | PDFvise"
  description="Crop PDF pages online without uploading, with no watermarks, and completely free. Crop PDF files in your browser."
>
  <SectionRibbon
    title="Crop PDF"
    description="Trim the same amount from every page."
  />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFPagesLazy tool="crop" client:load />
    </div>
    <SectionHowTo
      title="How to crop a PDF?"
      description="Crop PDF pages online without uploading, with no watermarks, and completely free."
    >
      <ol>
        <li>Select PDF files</li>
        <li>Set the crop on each edge, in inches, centimeters, or millimeters</li>
        <li>Save & Download</li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  items={[
    { question: "Does crop remove the same strip from every page?", answer: "Yes. The four values are added to any crop already stored in the file. Use zero when an edge should stay as it is." },
  ]}
/>
  </div>
</BaseLayout>
