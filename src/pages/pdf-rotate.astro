---
import SectionFaq from "@/components/SectionFaq/index.astro";
import SectionHowTo from "@/components/SectionHowTo/index.astro";
import SectionPDFMetaLazy from "@/components/SectionPDFMeta/lazy";
import SectionRibbon from "@/components/SectionRibbon/index.astro";
import BaseLayout from "@/layouts/base.astro";
---

<BaseLayout
  title="Rotate PDF files online for free. | PDFvise"
  description="Rotate PDF files online without uploading, with no watermarks, & completely free!. Rotate PDF files easily on your browser only!."
>
  <SectionRibbon
    title="Rotate PDF File"
    description="Rotate entire PDF file or multiple PDF files"
  />
  <div
    class="container"
    style="display: flex; flex-direction: column; margin-top: calc(2 * var(--pico-spacing)); margin-bottom: calc(2 * var(--pico-spacing)); gap: calc(2 * var(--pico-spacing));"
  >
    <div style="margin-bottom: calc(3 * var(--pico-spacing));">
      <SectionPDFMetaLazy tool="rotate" client:load />
    </div>
    <SectionHowTo
      title="How to rotate a PDF file?"
      description="Rotate PDF files online without uploading, with no watermarks, & completely free!. Rotate PDF files easily on your browser only!"
    >
      <ol>
        <li>Select all PDF files</li>
        <li>Re-order, Rotate, or Remove your files</li>
        <li>Save & Download</li>
      </ol>
    </SectionHowTo>
    <SectionFaq
  items={[
    { question: "Where is the rotation saved?", answer: "Each click of Rotate All turns every page by 90 degrees. Save & Download writes that rotation into the PDF. The file stays in your browser." },
  ]}
/>
  </div>
</BaseLayout>
