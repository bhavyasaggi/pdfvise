---
import Card from "@/lib/ui/Card";
import Icon from "@/lib/ui/Icon";

interface Props {
	note?: string;
	href?: string;
	hrefLabel?: string;
}

const { note, href, hrefLabel } = Astro.props;
---

<section class="container" style="padding: calc(3 * var(--pico-spacing)) 0;">
  <Card style={{ minHeight: "240px" }}>
    <div style={{ margin: "auto", textAlign: "center", maxWidth: "36rem" }}>
      <Icon icon="coffee" height={32} width={32} title="Coming soon" />
      <div><strong>Coming Soon!</strong></div>
      {note ? <p>{note}</p> : null}
      {
        href && hrefLabel ? (
          <a href={href}>
            <strong>{hrefLabel}</strong>
          </a>
        ) : null
      }
    </div>
  </Card>
</section>
