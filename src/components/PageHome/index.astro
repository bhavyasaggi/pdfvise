---
import type { FeatherIconNames } from "feather-icons";
import ASSET_DEVICES from "@/assets/devices.svg?url";
import ASSET_HERO from "@/assets/hero.svg?url";
import ASSET_SECURE from "@/assets/secure.svg?url";
import ASSET_STATS from "@/assets/stats.svg?url";
import ASSET_WAITING from "@/assets/waiting.svg?url";
import SectionFaq from "@/components/SectionFaq/index.astro";
import NAV_LINKS from "@/json/nav-links.json";
import Icon from "@/lib/ui/Icon";

import styles from "./styles.module.scss";

type NavLinkItem = {
	href: string;
	icon: string;
	label: string;
	description: string;
};

type NavSection = {
	label: string;
	links: NavLinkItem[];
};

const NAV_LINKS_FLAT = (NAV_LINKS as NavSection[]).flatMap(
	(item) => item.links,
);
---

<section
  class="container"
  style={{
    display: "flex",
    flexWrap: "wrap",
    minHeight: "200px",
    paddingTop: "var(--pico-spacing)",
  }}
>
  <div style={{ maxWidth: "800px", alignSelf: "center", flex: "1 1 auto" }}>
    <h1 style={{ color: "var(--pico-primary)" }}>Easy-to-use PDF tools</h1>
    <p style={{ color: "var(--pico-muted-color)" }}>
      PDFvise is all about convenience and transparency.
      <br />
      Find effective and simple PDF solutions in just a few steps.
    </p>
  </div>
  <div
    role="presentation"
    style={{
      marginLeft: "auto",
      minWidth: "72px",
      minHeight: "64px",
      maxWidth: "570px",
      maxHeight: "256px",
      background: `transparent url("${ASSET_HERO}") center bottom / contain no-repeat`,
      aspectRatio: "570 / 256",
      alignSelf: "end",
      flex: "1 1 50%",
      transform: `translateY(${((100 * 26) / 256).toFixed(4)}%)`,
    }}
  >
  </div>
</section>
<div class={styles.ribbon}>
  <section class:list={["container", styles.ribbonGrid]}>
    {
      NAV_LINKS_FLAT.map((item) => (
        <a href={item.href} class:list={["hover", styles.card]}>
          <div class={styles.cardTitle}>
            <div class={styles.cardTitleIcon}>
              <Icon
                icon={item.icon as FeatherIconNames}
                height={16}
                width={16}
                title={item.label}
                decorative
                strokeWidth={2}
              />
            </div>
            <span>{item.label}</span>
          </div>
          <small class={styles.cardDescription}>{item.description}</small>
        </a>
      ))
    }
  </section>
</div>
<section class="container">
  <h2 class={styles.sectionHeading}>Why use PDFvise?</h2>
  <div class={styles.features}>
    <div class:list={[styles.featureFigure, styles.featureFigureFirst]}>
      <img
        loading="lazy"
        src={ASSET_WAITING}
        alt="Free"
        width={380}
        height={286}
      />
    </div>
    <div>
      <h3 class={styles.cardTitle}>Free</h3>
      <p>
        PDFvise is free for both personal and commercial use. It does not require
        user registration or email verification. All tools are available with no
        limits: split PDFs, merge multiple PDFs into one, rearrange pages, and
        more.
      </p>
    </div>
    <div class={styles.featureFigure}>
      <img
        loading="lazy"
        src={ASSET_SECURE}
        alt="Secure"
        width={380}
        height={286}
      />
    </div>
    <div>
      <h3 class={styles.cardTitle}>Secure</h3>
      <p>
        PDFvise is absolutely secure. The entire process happens directly in
        your browser. Your files stay on your system. Nothing is uploaded.
      </p>
    </div>
    <div class={styles.featureFigure}>
      <img
        loading="lazy"
        src={ASSET_STATS}
        alt="Fast & Simple"
        width={380}
        height={286}
      />
    </div>
    <div>
      <h3 class={styles.cardTitle}>Fast & Simple</h3>
      <p>
        PDFvise is user-friendly and accessible. Without installation of
        additional software you can perform any action in just 3 simple steps.
        Most files finish in a few seconds. A single PDF can be up to 100 MB.
      </p>
    </div>
    <div class:list={[styles.featureFigure, styles.featureFigureLast]}>
      <img
        loading="lazy"
        src={ASSET_DEVICES}
        alt="Cross-platform"
        width={380}
        height={286}
      />
    </div>
    <div>
      <h3 class={styles.cardTitle}>Cross-platform</h3>
      <p>
        PDFvise is completely web-based and can be accessed wherever you are,
        from any computer. It is compatible with all major browsers and
        operating systems, including Windows, Mac OS X, and Linux.
      </p>
    </div>
  </div>
</section>
<SectionFaq
  items={[
    { question: "Does PDFvise require any downloads?", answer: "PDFvise runs in the browser. There is no download or installation required." },
    { question: "How safe is PDFvise?", answer: "No data is transferred and no files are uploaded to any secondary location. All the processing happens in the browser using Javascript." },
    { question: "Does PDFvise keep a copy of files?", answer: "Absolutely not. No files are transferred to any secondary location. Everything stays secure at your system and your browser." },
    { question: "Is PDFvise free to use?", answer: "There is no account and no daily cap. A single PDF can be up to 100 MB." },
    { question: "Is registration necessary on PDFvise?", answer: "No need to subscribe or register. There is nothing to block you from using PDFvise Tools." },
    { question: "How long do PDFvise tools take?", answer: "Files stay in the browser, so most tools finish in a few seconds. Larger files take longer on a slower computer." },
    { question: "Why is PDFvise taking so long?", answer: "Processing speed depends on the size of the file and the processing power of your system." },
    { question: "What are system requirements for PDFvise?", answer: "PDFvise runs in current versions of Chrome, Firefox, Safari, and Edge." },
    { question: "Is PDFvise supported on Android and iOS?", answer: "PDFvise is a browser-based online tool and supports all the modern browsers in any operating system like iOS (iPhone & iPad), Android, Windows, Linux, etc." },
    { question: "Can I Use PDFvise for My Business?", answer: "PDFvise is a free tool, so feel free to use it for all your needs. If it is useful, a credit is appreciated." },
  ]}
/>
