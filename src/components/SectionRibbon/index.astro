---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<hgroup
  style={{
    padding: `calc(2 * var(--pico-spacing)) 0px`,
    minHeight: "240px",
    display: "flex",
    alignItems: "center",
    justifyContent: "center",
    textAlign: "center",
    backgroundColor: "var(--pico-primary-background)",
  }}
>
  <div class="container">
    <h1 style={{ color: "var(--pico-primary-inverse)" }}>{title}</h1>
    <div style={{ color: "var(--pico-primary-inverse)" }}>{description}</div>
  </div>
</hgroup>
