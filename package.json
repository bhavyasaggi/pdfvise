{
	"name": "pdfvise",
	"type": "module",
	"version": "0.2.0",
	"repository": "https://github.com/bhavyasaggi/pdfvise.git",
	"author": "Bhavya Saggi <bhavya.saggi@gmail.com>",
	"license": "AGPL-3.0-only",
	"scripts": {
		"prepare": "husky",
		"lint-staged": "lint-staged",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"format": "biome format --write",
		"typecheck": "astro check",
		"test": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test src/lib/utils/*.test.ts",
		"check": "biome check && astro check && node --experimental-strip-types --import ./scripts/register-ts.mjs --test src/lib/utils/*.test.ts",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/preact": "^4.1.3",
		"@astrojs/sitemap": "^3.7.0",
		"@picocss/pico": "^2.1.1",
		"astro": "^5.16.11",
		"feather-icons": "^4.29.2",
		"jszip": "^3.10.1",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^5.4.530",
		"preact": "^10.28.2",
		"react-easy-sort": "^1.8.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "2.3.11",
		"@emnapi/runtime": "^1.11.3",
		"@types/feather-icons": "^4.29.4",
		"@types/node": "^26.6.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"sass-embedded": "^1.97.3",
		"sherif": "^1.9.0",
		"typescript": "^5.9.3",
		"yarn-deduplicate": "^6.0.2"
	},
	"overrides": {
		"react": "npm:@preact/compat@latest",
		"react-dom": "npm:@preact/compat@latest"
	},
	"resolutions": {
		"react": "npm:@preact/compat@latest",
		"react-dom": "npm:@preact/compat@latest"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "yarn@1.22.22",
	"lint-staged": {
		"*.{js,mjs,cjs,ts,tsx,astro,json,scss,css,md}": "biome check --write --no-errors-on-unmatched"
	}
}
